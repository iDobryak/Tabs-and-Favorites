{
  "manifest_version": 3,
  "name": "Tab Duplicate Cleaner",
  "version": "1.1.0",
  "description": "Find, close and sort duplicate Chrome tabs across all windows.",
  "permissions": ["tabs", "storage"],
  "action": {
    "default_title": "Tab Duplicate Cleaner",
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
